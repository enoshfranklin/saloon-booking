{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*\.(?:js|css|ico|png|jpg|svg|woff|woff2|ttf|eot))$",
      "destination": "/frontend/dist/salon-booking-frontend/browser/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/dist/salon-booking-frontend/browser/index.html"
    }
  ]
}
